NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
ALLOWED_USER_EMAIL=you@example.com
# Core study features do not need a server secret. Google Calendar, AI reports,
# and the private MCP gateway use this server-only key; never expose it to the browser.
# Canonical scheme + host (required for Google OAuth; no path/trailing slash):
APP_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_WEB_CLIENT_SECRET
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
GOOGLE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Optional server-only visual reading for scanned exam PDFs. Set both values.
# The upload also requires allow_visual_extraction=true for each PDF.
OPENAI_API_KEY=
PDF_VISION_MODEL=gpt-4o-mini
# Phase 3 is opt-in. On 2026-09-25 this account had $0 API credit;
# initial prepaid credit purchase is at least $5. Verify model access and current
# USD prices before paid calls. The $2 app estimate
# below is separate from an OpenAI project/organization monthly hard spend limit.
OPENAI_MODEL=gpt-6-astra
AI_INPUT_PRICE_PER_1M_USD=10
AI_OUTPUT_PRICE_PER_1M_USD=50
AI_MONTHLY_REQUEST_LIMIT=8
AI_MONTHLY_BUDGET_USD=2
# Enable only after production cron deployment and CRON_SECRET setup.
AI_SCHEDULER_ENABLED=false
CRON_SECRET=
# Private MCP stays disabled until HTTPS, OAuth, resource audience, restrictive
# Data API/PDF Storage policies, and the four-command server gateway are verified.
# Hook/gateway migrations passed remote SQL checks, but hook config is empty;
# live OAuth and direct Data API/PDF Storage rejection remain unverified.
MCP_ENABLED=false
MCP_PUBLIC_URL=
