NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
ALLOWED_USER_EMAIL=you@example.com
# Optional server-only state cache. Use a Redis database near Supabase/Vercel.
# Reads still check live database authorization, revision and countdown state.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Core study features do not need a server secret. Google Calendar, AI reports,
# and the private MCP gateway use this server-only key; never expose it to the browser.
# Canonical scheme + host (required for Google OAuth; no path/trailing slash):
APP_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_WEB_CLIENT_SECRET
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
GOOGLE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# AI is off until BOTH this switch and private.ai_budget_policy are configured.
# Ordinary study features never require AI. Automatic scheduling is disabled.
AI_ENABLED=false
OPENAI_API_KEY=
# Pilot text model; no automatic model fallback. Official standard rates checked 2026-09-28:
# https://developers.openai.com/api/docs/models/gpt-6-luna (USD per 1M text tokens).
OPENAI_MODEL=gpt-6-luna
AI_INPUT_PRICE_PER_1M_USD=0.10
AI_OUTPUT_PRICE_PER_1M_USD=0.50
# Example APPLICATION total monthly budget, not an observed invoice.
# Also configure private.ai_budget_policy by an approved production change.
AI_MONTHLY_BUDGET_USD=2
# The per-account Istanbul-month cap is fixed at 4 in server/SQL, never an env override.
AI_SCHEDULER_ENABLED=false
CRON_SECRET=
# Private MCP stays disabled until HTTPS, OAuth, resource audience, restrictive
# Data API/PDF Storage policies, and the four-command server gateway are verified.
# Hook/gateway migrations passed remote SQL checks, but hook config is empty;
# live OAuth and direct Data API/PDF Storage rejection remain unverified.
MCP_ENABLED=false
MCP_PUBLIC_URL=

# Classroom registration uses server-side Supabase Auth creation. New applicants
# do not receive a confirmation message; reviewer approval is in the app.
# SUPABASE_SECRET_KEY is required for this server-only registration path.
# Keep APP_ORIGIN/auth/callback?type=recovery allowlisted for password reset.
# Classroom administrator is an approved classroom_accounts admin, never a signup role.
# ALLOWED_USER_EMAIL and owner_allowlist protect the original private study area separately.
ADMIN_NOTIFICATION_EMAIL=admin@example.invalid
# Approval happens in the admin/teacher panel. Registration emails are disabled
# by the classroom migration; password-recovery email is a separate Auth flow.
CLASSROOM_EMAIL_NOTIFICATIONS_ENABLED=false
# Legacy email notification settings; the in-app-only migration disables delivery.
RESEND_API_KEY=
CLASSROOM_EMAIL_FROM=
# Explicit LOCAL DEVELOPMENT simulator only; production always rejects it.
# pnpm dev:demo sets this and isolates all external service credentials.
CLASSROOM_DEMO_ENABLED=false
# Local demo binds 127.0.0.1; it is not a public Internet address.
CLASSROOM_DEMO_PORT=3300
# pg_cron schedules durable classroom followups every minute if available.
# Otherwise call GET /api/cron/classroom every minute with Bearer CRON_SECRET.
