-- Run after creating a single Auth user. Replace the UUID in the owner insert separately.
create table public.owner_allowlist(user_id uuid primary key references auth.users(id) on delete cascade);
alter table public.owner_allowlist enable row level security;
create function public.is_owner() returns boolean language sql stable security definer set search_path = '' as $$
  select exists(select 1 from public.owner_allowlist where user_id=(select auth.uid()))
$$;
revoke all on function public.is_owner() from public, anon;
grant execute on function public.is_owner() to authenticated;
create table public.profiles(
 user_id uuid primary key references auth.users(id) on delete cascade,
 display_name text not null default 'Sümeyra', exam_year int not null default 2027,
 target_rank int, timezone text not null default 'Europe/Istanbul', daily_target_minutes int not null default 360 check(daily_target_minutes>=0),
 theme text not null default 'steel', updated_at timestamptz not null default now()
);
create table public.topics(
 id uuid primary key default gen_random_uuid(), user_id uuid not null references auth.users(id) on delete cascade,
 exam text not null check(exam in ('TYT','AYT')), subject text not null, name text not null,
 parent_id uuid references public.topics(id) on delete set null,
 mastery int not null default 0 check(mastery between 0 and 4), notes text not null default '',
 updated_at timestamptz not null default now(), unique(user_id,exam,subject,name)
);
create table public.topic_history(
 id uuid primary key default gen_random_uuid(), user_id uuid not null references auth.users(id) on delete cascade,
 topic_id uuid not null references public.topics(id) on delete cascade,
 old_mastery int, new_mastery int not null check(new_mastery between 0 and 4), changed_at timestamptz not null default now()
);
create table public.tasks(
 id uuid primary key default gen_random_uuid(), user_id uuid not null references auth.users(id) on delete cascade,
 title text not null check(length(title) between 1 and 240), plan_date date not null,
 exam text, subject text, topic_id uuid references public.topics(id) on delete set null,
 planned_minutes int not null default 30 check(planned_minutes>=0), difficulty text not null default 'medium' check(difficulty in ('easy','medium','hard')),
 progress numeric(4,3) not null default 0 check(progress between 0 and 1),
 weight_override numeric(10,2) check(weight_override>=0), position int not null default 0,
 notes text not null default '', created_at timestamptz not null default now(), updated_at timestamptz not null default now()
);
create table public.study_sessions(
 id uuid primary key default gen_random_uuid(), user_id uuid not null references auth.users(id) on delete cascade,
 title text not null default 'Çalışma', task_id uuid references public.tasks(id) on delete set null,
 subject text, topic_id uuid references public.topics(id) on delete set null,
 study_type text not null default 'Soru çözümü', mode text not null default 'stopwatch' check(mode in ('stopwatch','countdown')),
 target_seconds int check(target_seconds>0), started_at timestamptz not null default now(),
 active_since timestamptz, accumulated_seconds int not null default 0 check(accumulated_seconds>=0),
 finished_at timestamptz, status text not null default 'running' check(status in ('running','paused','finished')),
 constraint valid_state check((status='running' and active_since is not null and finished_at is null) or (status='paused' and active_since is null and finished_at is null) or (status='finished' and active_since is null and finished_at is not null))
);
create unique index one_active_session on public.study_sessions(user_id) where status in ('running','paused');
create table public.daily_plan_versions(
 id uuid primary key default gen_random_uuid(), user_id uuid not null references auth.users(id) on delete cascade,
 plan_date date not null, version int not null, target_minutes int not null check(target_minutes>=0),
 task_share numeric(4,3) not null default .7 check(task_share between 0 and 1),
 snapshot jsonb not null default '{}'::jsonb, changed_at timestamptz not null default now(),
 unique(user_id,plan_date,version)
);
create table public.audit_log(
 id uuid primary key default gen_random_uuid(), user_id uuid not null references auth.users(id) on delete cascade,
 entity text not null, entity_id uuid not null, action text not null, old_value jsonb, new_value jsonb,
 occurred_at timestamptz not null default now()
);
create function public.record_change() returns trigger language plpgsql security invoker set search_path='' as $$
begin
 if tg_op='UPDATE' and tg_table_name='topics' and old.mastery is distinct from new.mastery then
  insert into public.topic_history(user_id,topic_id,old_mastery,new_mastery) values(new.user_id,new.id,old.mastery,new.mastery);
 end if;
 return new;
end $$;
create trigger topic_change after update on public.topics for each row execute function public.record_change();
create function public.enforce_owner() returns trigger language plpgsql security invoker set search_path='' as $$
begin
 if new.user_id is distinct from (select auth.uid()) or not public.is_owner() then raise exception 'unauthorized'; end if;
 return new;
end $$;
create trigger owner_topic before insert or update on public.topics for each row execute function public.enforce_owner();
create trigger owner_task before insert or update on public.tasks for each row execute function public.enforce_owner();
create trigger owner_session before insert or update on public.study_sessions for each row execute function public.enforce_owner();
do $$ declare t text; begin
 foreach t in array array['profiles','topics','topic_history','tasks','study_sessions','daily_plan_versions','audit_log'] loop
  execute format('alter table public.%I enable row level security',t);
  execute format('create policy owner_select on public.%I for select to authenticated using (user_id=(select auth.uid()) and (select public.is_owner()))',t);
  execute format('create policy owner_insert on public.%I for insert to authenticated with check (user_id=(select auth.uid()) and (select public.is_owner()))',t);
  execute format('create policy owner_update on public.%I for update to authenticated using (user_id=(select auth.uid()) and (select public.is_owner())) with check (user_id=(select auth.uid()) and (select public.is_owner()))',t);
  execute format('create policy owner_delete on public.%I for delete to authenticated using (user_id=(select auth.uid()) and (select public.is_owner()))',t);
 end loop;
end $$;
revoke all on all tables in schema public from anon;
grant select,insert,update,delete on public.profiles,public.topics,public.tasks,public.study_sessions,public.daily_plan_versions to authenticated;
grant select on public.topic_history,public.audit_log to authenticated;
